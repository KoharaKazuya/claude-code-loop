#!/bin/sh
# ccloop のランチャー。CCLOOP_HOME(= lib/ の絶対パス)を自分の実体から決めて cli.ts を
# Node で直接実行する。ビルド成果物は持たず、Node の型ストリップで .ts をそのまま動かす。
#
# CCLOOP_HOME は常に自分の ../lib にする(呼び出し側の環境変数を尊重しない)。
# ccloop 自身のインストール先は「このランチャーの置き場」以外に決めようがなく、
# 環境変数での上書きを許すと、指し先がずれた CCLOOP_HOME を使ってしまう事故につながるため。
set -e
self="$(readlink -f "$0")"
CCLOOP_HOME="$(dirname "$self")/../lib"
export CCLOOP_HOME
exec node --no-warnings=ExperimentalWarning "$CCLOOP_HOME/cli.ts" "$@"
