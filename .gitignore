# 末尾スラッシュなし: worktree では node_modules が symlink になり、
# ディレクトリ限定パターン(node_modules/)ではマッチしないため
node_modules

# API キーなどの秘密。実装は環境変数を直接読むのでこのファイルは使わないが、
# 利用者が置いた場合に git 管理下へ入らないようにする
.env
.env.*

# 自律実行の実行時ファイル。STOP は停止指示、*.tmp はアトミック書き込みの一時ファイル
.agent/STOP
.agent/**/*.tmp
.agent/state.json
.agent/metrics.jsonl
.agent/permission-denials.jsonl
# セッションの未コミット差分の退避先。worktree の削除で失われないようパッチとして残すが、
# 検証もコミットもされていない差分なので git 管理下には入れない
.agent/patches/
