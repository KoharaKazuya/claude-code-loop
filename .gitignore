# 末尾スラッシュなし: worktree では node_modules が symlink になり、
# ディレクトリ限定パターン(node_modules/)ではマッチしないため
node_modules

# API キーなどの秘密。実装は環境変数を直接読むのでこのファイルは使わないが、
# 利用者が置いた場合に git 管理下へ入らないようにする
.env
.env.*

# アトミック書き込みの一時ファイル。実行時状態(state.json / metrics.jsonl /
# permission-denials.jsonl / patches/ / worktrees/)はリポジトリ外の state ディレクトリ
# (${XDG_STATE_HOME:-~/.local/state}/ccloop/<repo-id>)に置くため、ここには現れない
.agent/**/*.tmp

# CI/リリースワークフローがリポジトリの lib/ と bin/ と package.json をコピーして生成する成果物
features/ccloop/lib
features/ccloop/bin
features/ccloop/package.json
