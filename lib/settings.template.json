{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(diff *)"
    ],
    "deny": [
      "Read(~/.claude/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.agent/claude-settings.json)",
      "Edit(./.agent/config.json)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings=ExperimentalWarning \"$CCLOOP_HOME/hooks/deny-ask-user.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings=ExperimentalWarning \"$CCLOOP_HOME/hooks/stop-check.ts\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings=ExperimentalWarning \"$CCLOOP_HOME/hooks/worktree-create.ts\""
          }
        ]
      }
    ]
  }
}
