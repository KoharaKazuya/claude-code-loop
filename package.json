{
  "name": "claude-code-loop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "version": "node scripts/sync-version.mjs && git add features/ccloop/devcontainer-feature.json README.md .devcontainer/devcontainer.json",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
