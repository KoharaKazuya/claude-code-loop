{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "target": "es2023",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mjs"]
}
